rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      // Publik (seluruh masyarakat) dapat membuat laporan pengaduan
      allow create: if request.resource.data.ticketCode is string
        && request.resource.data.victimName is string
        && request.resource.data.incidentDescription is string;

      // Pelapor dapat melacak nomor tiket dan Petugas Dinas dapat mengelola di dasbor
      allow read: if true;

      // Pembaruan status/catatan atau penghapusan kasus oleh petugas dinas
      allow update, delete: if true;
    }
  }
}
